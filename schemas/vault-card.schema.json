{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vault-card.schema.json",
  "title": "Vault card",
  "description": "วลีในคลังพร้อมสถานะการทบทวนแบบ SM-2 (store: vault)",
  "type": "object",
  "required": ["id", "type", "chunk", "cue", "example", "ef", "interval", "reps", "lapses", "due", "createdAt"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "type": { "const": "chunk" },
    "chunk": { "type": "string", "minLength": 1, "description": "วลีภาษาอังกฤษ" },
    "cue": { "type": "string", "description": "คำใบ้หรือความหมาย ใช้เป็นโจทย์ตอนทบทวน" },
    "example": { "type": "string" },
    "level": { "enum": ["", "B1", "B2", "C1", "C2"] },
    "source": { "type": "string", "description": "manual | feedback | reformulator" },
    "ef": { "type": "number", "minimum": 1.3, "description": "easiness factor" },
    "interval": { "type": "integer", "minimum": 0, "description": "วัน" },
    "reps": { "type": "integer", "minimum": 0 },
    "lapses": { "type": "integer", "minimum": 0 },
    "due": { "type": "string", "format": "date" },
    "lastReviewed": { "type": ["string", "null"], "format": "date" },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
